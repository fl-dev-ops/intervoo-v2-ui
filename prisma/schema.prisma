generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enums
enum UserStage {
  ONBOARDING
  DIAGNOSTICS
  COMPLETED
}

enum InterviewSessionType {
  DIAGNOSTIC_ROUND
}

enum InterviewSessionStatus {
  STARTED
  COMPLETED
}

enum DiagnosticStatus {
  IN_PROGRESS
  COMPLETED
}

enum ReportStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum OrderStatus {
  CREATED
  ATTEMPTED
  PAID
  CANCELLED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum CouponDiscountType {
  FLAT
  PERCENTAGE
}

// Auth & User models
model User {
  id                  String             @id
  name                String
  email               String
  emailVerified       Boolean            @default(false)
  image               String?
  phoneNumber         String?            @unique
  phoneNumberVerified Boolean            @default(false)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  sessions            Session[]
  accounts            Account[]
  resume              Resume?
  progress            UserProgress?
  interviewSessions   InterviewSession[]
  diagnostics         Diagnostic[]
  orders              Order[]
  couponRedemptions   CouponRedemption[]

  @@map("user")
}

model UserProgress {
  id                     String    @id @default(cuid())
  userId                 String    @unique
  stage                  UserStage @default(ONBOARDING)
  onboardingCompletedAt  DateTime?
  diagnosticsCompletedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_progress")
}

model Resume {
  id                  String              @id @default(cuid())
  userId              String              @unique
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String              @default("")
  role                String              @default("")
  experienceYears     Float?
  education           Json                @default("[]")
  skills              String[]            @default([])
  experience          Json                @default("[]")
  projects            Json                @default("[]")
  skillGlosses        Json                @default("{}")
  projectKeywords     Json                @default("[]")
  projectCapabilities Json                @default("[]")
  workInitiatives     Json                @default("[]")
  resumeUrl           String?
  parsedResume        Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  jobAnalyses         ResumeJobAnalysis[]

  @@index([userId])
  @@map("resume")
}

model ResumeJobAnalysis {
  id        String   @id @default(cuid())
  resumeId  String
  jobId     String
  inputHash String
  analysis  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resume Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, jobId, inputHash])
  @@map("resume_job_analysis")
}

// BetterAuth session (keep existing)
model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Unified interview session table
model InterviewSession {
  id            String                 @id @default(cuid())
  userId        String
  type          InterviewSessionType
  roomName      String                 @unique
  status        InterviewSessionStatus @default(STARTED)
  transcript    Json?
  audioUrl      String?
  videoUrl      String?
  transcriptUrl String?
  metadata      Json? // { coach, interactionMode, deviceId, videoDeviceId }
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnosticRound DiagnosticRound?
  report          Report?

  @@index([userId])
  @@index([status])
  @@index([type])
  @@map("interview_session")
}

// Diagnostics wrapper (4 rounds)
model Diagnostic {
  id                    String           @id @default(cuid())
  userId                String
  status                DiagnosticStatus @default(IN_PROGRESS)
  currentRound          Int              @default(1)
  selectedBand          String?
  selectedJob           Json?
  finalReport           Json?
  finalReportShareToken String?          @unique
  paidAt                DateTime?
  orderId               String?          @unique
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order?            @relation(fields: [orderId], references: [id])
  rounds DiagnosticRound[]

  @@index([userId])
  @@map("diagnostic")
}

model Order {
  id              String      @id @default(cuid())
  razorpayOrderId String      @unique
  userId          String
  jobId           String
  amount          Int
  originalAmount  Int?
  discountAmount  Int         @default(0)
  couponCode      String?
  currency        String      @default("INR")
  receipt         String
  status          OrderStatus @default(CREATED)
  notes           Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  diagnostic        Diagnostic?
  payment           Payment?
  couponRedemptions CouponRedemption[]

  @@index([userId])
  @@index([jobId])
  @@map("order")
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  discountType   CouponDiscountType
  discountValue  Int
  maxUsesPerUser Int                @default(1)
  isActive       Boolean            @default(true)
  expiresAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  redemptions CouponRedemption[]

  @@map("coupon")
}

model CouponRedemption {
  id           String   @id @default(cuid())
  couponId     String
  userId       String
  diagnosticId String
  orderId      String?
  redeemedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([diagnosticId])
  @@index([userId])
  @@map("coupon_redemption")
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  razorpayPaymentId String        @unique
  razorpaySignature String?
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          String        @default("INR")
  method            String?
  receiptKey        String?
  capturedAt        DateTime?
  failedAt          DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([razorpayPaymentId])
  @@map("payment")
}

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String
  eventId   String
  payload   Json?
  createdAt DateTime @default(now())

  @@unique([provider, eventId])
  @@map("webhook_event")
}

// Individual diagnostic round
model DiagnosticRound {
  id           String                 @id @default(cuid())
  diagnosticId String
  sessionId    String                 @unique
  roundNumber  Int
  roundType    String
  status       InterviewSessionStatus @default(STARTED)

  diagnostic Diagnostic       @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([diagnosticId])
  @@map("diagnostic_round")
}

// Generic report table (separated from sessions)
model Report {
  id           String       @id @default(cuid())
  sessionId    String       @unique
  reportJson   Json?
  metadata     Json?
  proctoring   Json?
  status       ReportStatus @default(PENDING)
  errorMessage String?
  shareToken   String?      @unique
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  session InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("report")
}
